+        var email = new RecordingEmail();
+        var hub = new FakeHub();
+        var notifier = new PersistentWfNotifier(db, notif, new PrefService(db), email, hub,
+            NullLogger<PersistentWfNotifier>.Instance);
+        return new Rig(db, notifier, notif, email, hub);
+    }
