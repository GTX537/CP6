+        var idB = Guid.NewGuid();   // 已存在 v1，将被 UPSERT 到 v2
+        var idC = Guid.NewGuid();   // 全新，UPSERT 新建
+
+        async Task Seed(CP6Context db)
+        {
+            var c = new WmsBinConsumer(db);
