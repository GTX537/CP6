+  selects[0].vm.$emit('update:modelValue', 's1')
+  await flushPromises()
+  const s2 = w.findAllComponents(ElSelect)
+  s2[1].vm.$emit('update:modelValue', 'f1')
+  await flushPromises()
+}
+
+describe('SpacePublishView', () => {
