 const syncing = ref(false)
 const local = ref<SchemaNode>(cloneNode(props.node))
 
 watch(
   () => props.node,
   async (n) => {
     syncing.value = true
+    const idChanged = n.id !== local.value.id
     local.value = cloneNode(n)
