+    public static bool ContainsUnsupportedSubscript(string? text)
+    {
+        if (string.IsNullOrEmpty(text)) return false;
+        // $.path[...]  ——  $. 后跟标识符/点，直到出现下标括号
+        if (Regex.IsMatch(text, @"\$\.[A-Za-z0-9_.]*[\[\]]")) return true;
+        // {placeholder[...]}  ——  花括号占位内出现下标括号
