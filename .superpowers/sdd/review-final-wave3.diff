+
+  // ② 满页 50 行 → 次页按钮启用；点击后二次调用 page=2
+  it('满页时次页按钮启用并翻到 page=2', async () => {
+    const fullPage = Array.from({ length: 50 }, (_, i) => ev({ id: `e${i}`, sourceNo: `PUB-${i}` }))
+    vi.mocked(publishApi.events)
