+
+  it('含库位粒度段时不出现 E-306 提示', async () => {
+    const w = mountEditor([seg('zone-code'), seg('col')])
+    await flushPromises()
+    expect(w.text()).not.toContain('space.rule.err.E-306')
+  })
+})
