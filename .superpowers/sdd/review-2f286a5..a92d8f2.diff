+                new SiteDto { SiteCode = "WH2", SiteName = "s", WarehouseCd = "MAIN" }, "u"));
+        Assert.Equal("E-SPACE-406", ex.Code);
+
+        // 拒绝后锚原样
+        Assert.Equal("WH1", (await db.Space_Sites.SingleAsync(x => x.Id == siteId)).SiteCode);
+    }
+
+    [Fact]
