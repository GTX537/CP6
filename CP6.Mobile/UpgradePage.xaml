<ContentPage x:Class="CP6.Mobile.UpgradePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CP6.Mobile"
             x:DataType="local:UpgradeViewModel"
             Shell.NavBarIsVisible="False">
  <VerticalStackLayout Padding="28" Spacing="16" VerticalOptions="Center">
    <Label Text="{Binding Heading}" FontSize="30" FontAttributes="Bold" />
    <Grid ColumnDefinitions="Auto,*"
          RowDefinitions="Auto,Auto,Auto,Auto"
          ColumnSpacing="12"
          RowSpacing="6">
      <Label Text="{Binding Text.CurrentVersion}" />
      <Label Grid.Column="1" Text="{Binding CurrentVersion}" />
      <Label Grid.Row="1" Text="{Binding Text.LatestVersion}" />
      <Label Grid.Row="1" Grid.Column="1" Text="{Binding LatestVersion}" />
      <Label Grid.Row="2" Text="{Binding Text.MinimumVersion}" />
      <Label Grid.Row="2" Grid.Column="1" Text="{Binding MinimumVersion}" />
      <Label Grid.Row="3" Text="{Binding Text.ReleaseHash}" />
      <Label Grid.Row="3" Grid.Column="1" Text="{Binding ReleaseSha256}"
             LineBreakMode="CharacterWrap" FontFamily="monospace" />
    </Grid>
    <Label Text="{Binding DownloadUrl}" LineBreakMode="CharacterWrap" />
    <Button Text="{Binding Text.DownloadUpdate}"
            Command="{Binding DownloadCommand}"
            IsEnabled="{Binding CanDownloadUpdate}" />
    <Button Text="{Binding Text.RetryStartup}" Command="{Binding RetryCommand}" />
    <Button Text="{Binding Text.DeviceRecovery}"
            Command="{Binding OpenDeviceActivationCommand}" />
    <Label Text="{Binding Text.BusinessDisabled}" />
    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
    <Label Text="{Binding Message}" TextColor="#B42318" />
  </VerticalStackLayout>
</ContentPage>
