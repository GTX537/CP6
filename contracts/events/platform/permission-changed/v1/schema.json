{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.cp6.uk/events/platform/permission-changed/v1/schema.json",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "tenantid",
    "correlationid",
    "causationid",
    "aggregateid",
    "aggregateversion",
    "schemaversion",
    "region",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source": {
      "const": "urn:cp6:platform"
    },
    "type": {
      "const": "com.gtx537.platform.permission.changed.v1"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "const": "https://contracts.cp6.uk/events/platform/permission-changed/v1/schema.json"
    },
    "tenantid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "correlationid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "causationid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "aggregateid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "aggregateversion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "schemaversion": {
      "const": "1.0.0"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "data": {
      "type": "object",
      "required": [
        "tenantId",
        "subjectId",
        "enabled",
        "grants",
        "version"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(role:[1-9][0-9]*|user:[0-9a-f-]{36})$"
        },
        "enabled": {
          "type": "boolean"
        },
        "grants": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "resource",
              "action",
              "scope",
              "deptIds",
              "fields"
            ],
            "properties": {
              "resource": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "scope": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "deptIds": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 2048,
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "not": {
                    "const": "00000000-0000-0000-0000-000000000000"
                  }
                }
              },
              "fields": {
                "type": "array",
                "maxItems": 512,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": [
                    "field",
                    "access"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                    },
                    "access": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3
                    }
                  },
                  "propertyNames": {
                    "not": {
                      "enum": [
                        "name",
                        "displayName",
                        "userName",
                        "nickName",
                        "email",
                        "emailAddress",
                        "phone",
                        "mobile",
                        "password",
                        "passwordHash",
                        "cookie",
                        "token",
                        "accessToken",
                        "refreshToken",
                        "clientSecret",
                        "privateKey",
                        "authorization"
                      ]
                    }
                  }
                }
              }
            },
            "propertyNames": {
              "not": {
                "enum": [
                  "name",
                  "displayName",
                  "userName",
                  "nickName",
                  "email",
                  "emailAddress",
                  "phone",
                  "mobile",
                  "password",
                  "passwordHash",
                  "cookie",
                  "token",
                  "accessToken",
                  "refreshToken",
                  "clientSecret",
                  "privateKey",
                  "authorization"
                ]
              }
            }
          }
        },
        "deleted": {
          "type": "boolean"
        }
      },
      "propertyNames": {
        "not": {
          "enum": [
            "name",
            "displayName",
            "userName",
            "nickName",
            "email",
            "emailAddress",
            "phone",
            "mobile",
            "password",
            "passwordHash",
            "cookie",
            "token",
            "accessToken",
            "refreshToken",
            "clientSecret",
            "privateKey",
            "authorization"
          ]
        }
      }
    }
  },
  "propertyNames": {
    "not": {
      "enum": [
        "name",
        "displayName",
        "userName",
        "nickName",
        "email",
        "emailAddress",
        "phone",
        "mobile",
        "password",
        "passwordHash",
        "cookie",
        "token",
        "accessToken",
        "refreshToken",
        "clientSecret",
        "privateKey",
        "authorization"
      ]
    }
  }
}
