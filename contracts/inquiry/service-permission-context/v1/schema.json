{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CP6 actual inquiry service permission context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "issuer",
    "keyId",
    "algorithm",
    "catalogVersion",
    "requestNonce",
    "clientId",
    "organizationId",
    "subjectId",
    "authenticationEpoch",
    "registrationVersion",
    "sourcePayloadSha256",
    "contractBundleSha256",
    "permissionJson",
    "signature",
    "registrationRevision",
    "sourceVersion",
    "roleSources",
    "purpose",
    "siteId",
    "formId",
    "issuedAtUtc",
    "expiresAtUtc"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cp6-inquiry-service-context-v1"
    },
    "issuer": {
      "type": "string",
      "pattern": "^https://iam\\.[a-z0-9.-]+$",
      "maxLength": 200
    },
    "keyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{8,80}$"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "catalogVersion": {
      "const": "crm-permission-catalog-1"
    },
    "requestNonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "Canonical base64url of a fresh caller-generated 32-byte nonce, no padding; exact request binding."
    },
    "clientId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "subjectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "authenticationEpoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "registrationVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sourcePayloadSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contractBundleSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "permissionJson": {
      "type": [
        "string",
        "null"
      ],
      "description": "Unchanged signed R3 projection for intake:release; null for public:receive. Service authentication alone does not authorize H01."
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "description": "Canonical base64url Ed25519 over UTF-8 schemaVersion + LF + ordinal-key canonical body without signature; standard System.Text.Json string escaping."
    },
    "registrationRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "sourceVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "roleSources": {
      "type": "array",
      "minItems": 1,
      "description": "All registered role sources, including inactive sources. Exact aggregate/type/version/payload hash binding invalidates earlier signed grants when any current role source changes. No human-role-count cap.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregateId",
          "eventType",
          "version",
          "payloadSha256"
        ],
        "properties": {
          "aggregateId": {
            "type": "string",
            "pattern": "^permission:role:-?(0|[1-9][0-9]*)$"
          },
          "eventType": {
            "enum": [
              "com.gtx537.platform.permission.changed.v1",
              "com.gtx537.platform.permission.changed.v2",
              "com.gtx537.platform.permission.changed.v3"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "payloadSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "purpose": {
      "enum": [
        "intake:release",
        "public:receive",
        "privacy:retention-worker"
      ]
    },
    "siteId": {
      "type": "string",
      "format": "uuid"
    },
    "formId": {
      "type": "string",
      "format": "uuid"
    },
    "issuedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAtUtc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "public:receive"
          }
        }
      },
      "then": {
        "properties": {
          "permissionJson": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "permissionJson": {
            "type": "string"
          }
        }
      }
    }
  ]
}
