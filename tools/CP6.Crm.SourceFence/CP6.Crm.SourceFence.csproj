    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../contracts/c04a/TargetRollbackProtocol.cs" Link="TargetRollbackProtocol.cs" />
    <Compile Include="../../contracts/c04a/TargetRollbackSet.cs" Link="TargetRollbackSet.cs" />
    <Compile Include="../../contracts/c04a/SourceFrozenProof.cs" Link="SourceFrozenProof.cs" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
</Project>
