<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Probe</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(PlatformSnapshot)/src/CP6.Platform.Abstractions/CP6.Platform.Abstractions.csproj" />
    <ProjectReference Include="$(PlatformSnapshot)/src/CP6.Platform.AspNetCore/CP6.Platform.AspNetCore.csproj" />
    <ProjectReference Include="$(PlatformSnapshot)/src/CP6.Platform.Contracts/CP6.Platform.Contracts.csproj" />
    <ProjectReference Include="$(PlatformSnapshot)/src/CP6.Platform.EntityFramework/CP6.Platform.EntityFramework.csproj" />
    <ProjectReference Include="$(PlatformSnapshot)/src/CP6.Platform.Messaging/CP6.Platform.Messaging.csproj" />
  </ItemGroup>
  <Target Name="RequirePlatformSnapshot" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(PlatformSnapshot)' == ''" Text="An owner-local fixed PlatformSnapshot is required." />
  </Target>
</Project>
