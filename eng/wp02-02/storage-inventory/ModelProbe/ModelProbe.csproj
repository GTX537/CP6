<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(PackageRoot)/CP6.Core.dll" Private="false" />
    <Reference Include="$(PackageRoot)/CP6.Entity.dll" Private="false" />
    <Reference Include="$(PackageRoot)/CP6.Space.Infrastructure.dll" Private="false" />
    <Reference Include="$(PackageRoot)/CP6.Space.Application.dll" Private="false" />
    <Reference Include="$(PackageRoot)/CP6.Space.Domain.dll" Private="false" />
    <Reference Include="$(PackageRoot)/Microsoft.EntityFrameworkCore.dll" Private="false" />
    <Reference Include="$(PackageRoot)/Microsoft.EntityFrameworkCore.Abstractions.dll" Private="false" />
    <Reference Include="$(PackageRoot)/Microsoft.EntityFrameworkCore.Relational.dll" Private="false" />
    <Reference Include="$(PackageRoot)/Npgsql.dll" Private="false" />
    <Reference Include="$(PackageRoot)/Microsoft.AspNetCore.DataProtection.EntityFrameworkCore.dll" Private="false" />
    <Reference Include="$(PackageRoot)/Microsoft.Extensions.*.dll" />
    <Reference Include="$(PackageRoot)/System.Diagnostics.DiagnosticSource.dll" />
  </ItemGroup>
  <Target Name="RequirePublishedPackage" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(PackageRoot)/CP6.Core.dll')" Text="PackageRoot must identify an adopted Main publish directory." />
  </Target>
</Project>
