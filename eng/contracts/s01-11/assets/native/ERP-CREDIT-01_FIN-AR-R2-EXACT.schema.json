{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cp6.local/erp-credit-01/r2/ERP-CREDIT-01_FIN-AR-R2-EXACT.schema.json",
  "title": "Exact closed FIN-AR R2 credit branch projection",
  "x-cp6-source-commit": "44fcce0b2291f96d0099bebcce3563ba6fdeb8ea",
  "x-cp6-source-file-sha256": "3ada4bf654528c62bf160075ff83f090ea0914d0d7b15401422604691edb87f5",
  "x-cp6-source-lines": [
    "§2 scalar rules",
    "§11.1 public DTO",
    "§21.2 A34 SafeOperationDetail",
    "§24 Owner read union",
    "§30.1 Credit selection"
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "Key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "x-cp6-normalization": "NFC; no trim"
    },
    "Seq": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[01][0-9]{17}|92[01][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[01][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$"
    },
    "RV": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "contentEncoding": "base64",
      "x-cp6-semantics": "opaque CAS; never numeric"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "D8": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,19})(\\.[0-9]{1,8})?$"
    },
    "NonNegativeD8": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})(\\.[0-9]{1,8})?$"
    },
    "R12": {
      "type": "string",
      "pattern": "^(?:0\\.(?=[0-9]{1,12}$)(?=[0-9]*[1-9])[0-9]{1,12}|[1-9][0-9]{0,15}(?:\\.[0-9]{1,12})?)$"
    },
    "DateOnly": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "Utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "minLength": 24,
      "maxLength": 24
    },
    "Currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "minLength": 3,
      "maxLength": 3
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "MALFORMED_JSON",
        "AUTHENTICATION_REQUIRED",
        "ACTION_DENIED",
        "FIELD_DENIED",
        "SOD_VIOLATION",
        "NOT_FOUND_OR_NOT_VISIBLE",
        "INVALID_INPUT",
        "METHOD_UNSUPPORTED",
        "FUNDS_NOT_CLEARED",
        "COMPENSATION_REQUIRED",
        "ALREADY_APPLIED",
        "COVERAGE_UNPROVEN",
        "HEAD_CHANGED",
        "EXPECTED_HEAD_REQUIRED",
        "COMMAND_PAYLOAD_CONFLICT",
        "SOURCE_CONTENT_CONFLICT",
        "SOURCE_CHANGED",
        "SOURCE_GAP",
        "SOURCE_PROTECTION_UNPROVEN",
        "WRITER_FENCE_CONFLICT",
        "GROUPING_CONFLICT",
        "MISSING_PRICE",
        "MISSING_POD",
        "MISSING_COST",
        "MISSING_RATE",
        "POLICY_UNPROVEN",
        "OWNER_PARTICIPANT_UNPROVEN",
        "FUNDS_OWNER_UNPROVEN",
        "FUNDS_REVOKED",
        "DUPLICATE_TRANSACTION",
        "DUPLICATE_ALLOCATION",
        "INSUFFICIENT_BALANCE",
        "CUSTOMER_MISMATCH",
        "CROSS_CURRENCY_UNSUPPORTED",
        "PLAN_NOT_READY",
        "APPROVAL_REQUIRED",
        "PERIOD_CLOSED",
        "DEPENDENCY_LIMIT",
        "REPORT_LIMIT",
        "CURSOR_EXPIRED",
        "REVERSED_RESULT",
        "ALREADY_REVERSED",
        "INVARIANT_BROKEN",
        "UNAPPLY_REQUIRED",
        "PARTIAL_UNAPPLY_UNSUPPORTED",
        "UNSUPPORTED_SCHEMA",
        "TECHNICAL_RETRY",
        "AUTHORITY_UNAVAILABLE",
        "OUTCOME_UNKNOWN"
      ]
    },
