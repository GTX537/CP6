  "status": "OWNER_REVIEW_REQUIREMENT_NOT_ACCEPTED_PROTOCOL",
  "currentUse": "Public integrations only return typed fence; these schemas cannot make a receipt satisfiable",
  "mandatorySemanticChecks": [
    "MERGED requires exact mergedInto ref; other outcomes null",
    "WMS APPLIED expected range set exactly complete, partial remains unsatisfied",
