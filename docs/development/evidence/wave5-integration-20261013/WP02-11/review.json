  "findings": [
    {
      "id": "WP02-11-R1",
      "priority": "P2",
      "merge_blocking": true,
      "title": "Do not retry a received rejection when its body fails",
      "file": "src/CP6.Platform.AspNetCore/HttpV2/Cp6HttpV2Handler.cs",
      "line": 179,
      "supporting_lines": [
        147,
        148,
        152,
        157,
        171,
        180,
        208
      ],
      "description": "After receiving 401/403/409/422, body IO failure is wrapped as HttpRequestException or body timeout becomes AttemptTimeout. The circuit callback never returns received, so outer response is null. The transient expression forgets the known status and admits another attempt. This violates original HTTP line101 and docs line90. Proven writes can also replay after NotAppliedProven and authorization. Keep observed status independent of completed body and veto generic retries for these rejections, while preserving original-query recovery and Unknown. Existing status tests have complete bodies; body-failure tests use 200. Add status x IO/attempt-timeout read/write regressions asserting one send.",
      "verification": "Static control-flow finding; no tests executed in review."
    },
    {
      "id": "WP02-11-R2",
      "priority": "P2",
      "merge_blocking": true,
      "title": "Preserve typed operation outcome on authority faults",
      "file": "src/CP6.Platform.AspNetCore/HttpV2/Cp6HttpV2Handler.cs",
      "line": 210,
      "supporting_lines": [
        97,
        138,
        188,
        204,
        245,
        247,
        252
      ],
      "description": "A registered authorization adapter may throw synchronously or return a faulted ValueTask after a sent write and NotAppliedProven query. VerifyBindingAsync and AuthorizeReplayAsync sit outside transport catches; outer try only catches OperationCanceledException. Ordinary faults escape raw and leave RequestOption outcome absent, losing typed Unknown/attempt count/original identity. No authority contract forbids ordinary faults. Normalize expected faults into a safe typed outcome without another send, preserve caller/deadline precedence, and retain NotSent on pre-send verification failure. Original HTTP lines73/97 and docs108 require retained operation state. Add synchronous/asynchronous exception regressions at verify/replay, including cancellation and timeout races.",
      "verification": "Static control-flow finding; no tests executed in review."
    }
  ],
