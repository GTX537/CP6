{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cp6.local/contracts/cad/v1/autocad-primary-evaluation.schema.json",
  "title": "CP6 AutoCAD Primary golden dataset evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceClass",
    "evaluatedAtUtc",
    "datasetVersion",
    "datasetManifestSha256",
    "sourceSetSha256",
    "goldenDatasetSha256",
    "providerKey",
    "providerVersion",
    "workerReleaseSha256",
    "sourceCommit",
    "autoCadCoreConsoleVersion",
    "autoCadCoreConsoleSha256",
    "frozenEnvironmentSha256",
    "environment",
    "sampleCount",
    "dwgCount",
    "dxfCount",
    "calibrationCount",
    "validationCount",
    "releaseHoldoutCount",
    "totalEntityCount",
    "totalSupportedEntityCount",
    "totalUnsupportedEntityCount",
    "totalMissingSourceRefCount",
    "totalIssueCount",
    "totalBlockingIssueCount",
    "supportedEntityPercent",
    "firstRunP95Seconds",
    "firstRunMaximumSeconds",
    "deterministicReplayCount",
    "residualAttemptDirectoryCount",
    "residualRawCadFileCount",
    "passed",
    "blockingCodes",
    "results"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceClass": { "const": "CP6_SPACE_AUTOCAD_PRIMARY_GOLDEN_EVALUATION" },
    "evaluatedAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "datasetVersion": { "$ref": "#/$defs/nonEmpty" },
    "datasetManifestSha256": { "$ref": "#/$defs/sha256" },
    "sourceSetSha256": { "$ref": "#/$defs/sha256" },
    "goldenDatasetSha256": { "$ref": "#/$defs/sha256" },
    "providerKey": { "const": "cp6-autocad-worker" },
    "providerVersion": { "$ref": "#/$defs/nonEmpty" },
    "workerReleaseSha256": { "$ref": "#/$defs/sha256" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "autoCadCoreConsoleVersion": { "$ref": "#/$defs/nonEmpty" },
    "autoCadCoreConsoleSha256": { "$ref": "#/$defs/sha256" },
    "frozenEnvironmentSha256": { "$ref": "#/$defs/sha256" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeIdentifier",
        "operatingSystem",
        "framework",
        "osArchitecture",
        "processArchitecture",
        "processorCount",
        "conversionTimeoutSeconds",
        "maximumConcurrency",
        "executionMode",
        "networkListenerStarted",
        "outboundNetworkPolicy",
        "businessIdentityExcludedByProtocol",
        "rawCadRetentionMode"
      ],
      "properties": {
        "runtimeIdentifier": { "$ref": "#/$defs/nonEmpty" },
        "operatingSystem": { "$ref": "#/$defs/nonEmpty" },
        "framework": { "$ref": "#/$defs/nonEmpty" },
        "osArchitecture": { "$ref": "#/$defs/nonEmpty" },
        "processArchitecture": { "$ref": "#/$defs/nonEmpty" },
        "processorCount": { "type": "integer", "minimum": 1 },
        "conversionTimeoutSeconds": { "const": 120 },
        "maximumConcurrency": { "const": 1 },
        "executionMode": { "const": "SealedWorkerDirectContractEvaluation" },
        "networkListenerStarted": { "const": false },
        "outboundNetworkPolicy": { "const": "NotVerifiedAtOsBoundary" },
        "businessIdentityExcludedByProtocol": { "const": true },
        "rawCadRetentionMode": { "const": "EphemeralDeleteInFinally" }
      }
    },
    "sampleCount": { "const": 20 },
    "dwgCount": { "const": 10 },
    "dxfCount": { "const": 10 },
    "calibrationCount": { "const": 10 },
    "validationCount": { "const": 5 },
    "releaseHoldoutCount": { "const": 5 },
    "totalEntityCount": { "$ref": "#/$defs/nonNegativeInteger" },
    "totalSupportedEntityCount": { "$ref": "#/$defs/nonNegativeInteger" },
    "totalUnsupportedEntityCount": { "$ref": "#/$defs/nonNegativeInteger" },
    "totalMissingSourceRefCount": { "$ref": "#/$defs/nonNegativeInteger" },
    "totalIssueCount": { "$ref": "#/$defs/nonNegativeInteger" },
    "totalBlockingIssueCount": { "$ref": "#/$defs/nonNegativeInteger" },
    "supportedEntityPercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "firstRunP95Seconds": { "type": "number", "minimum": 0 },
    "firstRunMaximumSeconds": { "type": "number", "minimum": 0 },
    "deterministicReplayCount": { "type": "integer", "minimum": 0, "maximum": 20 },
    "residualAttemptDirectoryCount": { "$ref": "#/$defs/nonNegativeInteger" },
    "residualRawCadFileCount": { "$ref": "#/$defs/nonNegativeInteger" },
    "passed": { "type": "boolean" },
    "blockingCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "results": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sampleId",
          "sampleRef",
          "split",
          "layoutFamily",
          "sourceFormat",
          "sourceSha256",
          "sourceSizeBytes",
          "firstRunSeconds",
          "replayRunSeconds",
          "packageSha256",
          "layerCount",
          "blockCount",
          "entityCount",
          "supportedEntityCount",
          "unsupportedEntityCount",
          "missingSourceRefCount",
          "issueCount",
          "blockingIssueCount",
          "deterministicReplay",
          "passed",
          "blockingCodes"
        ],
        "properties": {
          "sampleId": { "type": "string", "pattern": "^L[1-5]-(?:C0[12]|V01|H01)$" },
          "sampleRef": {
            "type": "string",
            "pattern": "^urn:cp6-space-golden-cad:[A-Za-z0-9][A-Za-z0-9:._-]{0,200}$"
          },
          "split": { "enum": ["Calibration", "Validation", "ReleaseHoldout"] },
          "layoutFamily": { "enum": ["L1", "L2", "L3", "L4", "L5"] },
          "sourceFormat": { "enum": ["DWG", "DXF"] },
          "sourceSha256": { "$ref": "#/$defs/sha256" },
          "sourceSizeBytes": { "type": "integer", "minimum": 1 },
          "firstRunSeconds": { "type": "number", "minimum": 0 },
          "replayRunSeconds": { "type": "number", "minimum": 0 },
          "packageSha256": { "$ref": "#/$defs/sha256" },
          "layerCount": { "$ref": "#/$defs/nonNegativeInteger" },
          "blockCount": { "$ref": "#/$defs/nonNegativeInteger" },
          "entityCount": { "$ref": "#/$defs/nonNegativeInteger" },
          "supportedEntityCount": { "$ref": "#/$defs/nonNegativeInteger" },
          "unsupportedEntityCount": { "$ref": "#/$defs/nonNegativeInteger" },
          "missingSourceRefCount": { "$ref": "#/$defs/nonNegativeInteger" },
          "issueCount": { "$ref": "#/$defs/nonNegativeInteger" },
          "blockingIssueCount": { "$ref": "#/$defs/nonNegativeInteger" },
          "deterministicReplay": { "type": "boolean" },
          "passed": { "type": "boolean" },
          "blockingCodes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 500 },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 }
  }
}
