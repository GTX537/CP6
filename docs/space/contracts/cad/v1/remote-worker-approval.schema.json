{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cp6.local/contracts/cad/v1/remote-worker-approval.schema.json",
  "title": "CP6 CAD remote Worker approval Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerKey",
    "providerVersion",
    "displayName",
    "deploymentMode",
    "dataBoundary",
    "supportsDwg",
    "supportsDxf",
    "endpoint",
    "serverCertificateSha256",
    "clientCertificateThumbprint",
    "clientCertificateReference",
    "workerReleaseSha256",
    "workerIdentityReference",
    "mutuallyAuthenticatedTls",
    "outboundNetworkDisabled",
    "businessCredentialsUnavailable",
    "rawCadDeletedOnCompletion",
    "artifactOnlyResponse",
    "sourceHashVerifiedBeforeConversion",
    "converterContractRunnerEnforced",
    "licensingApprovalReference",
    "securityApprovalReference",
    "dataRegionApprovalReference",
    "deletionRetentionApprovalReference",
    "qualificationScore",
    "qualificationRubricVersion",
    "goldenDatasetSha256",
    "frozenEnvironmentSha256",
    "qualificationEvidenceReference",
    "validFromUtc",
    "expiresAtUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "providerKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "providerVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "deploymentMode": {
      "enum": ["OnPremisesIsolatedWorker", "PrivateCloudWorker", "ApprovedCloudService"]
    },
    "dataBoundary": {
      "enum": ["SiteLocal", "CustomerPrivateCloud", "CustomerApprovedCloudRegion"]
    },
    "supportsDwg": { "type": "boolean" },
    "supportsDxf": { "type": "boolean" },
    "endpoint": { "type": "string", "format": "uri", "pattern": "^https://.*/$" },
    "serverCertificateSha256": { "$ref": "#/$defs/sha256" },
    "clientCertificateThumbprint": {
      "type": "string",
      "pattern": "^(?:[A-Fa-f0-9]{40}|[A-Fa-f0-9]{64})$"
    },
    "clientCertificateReference": { "$ref": "#/$defs/evidence" },
    "workerReleaseSha256": { "$ref": "#/$defs/sha256" },
    "workerIdentityReference": { "$ref": "#/$defs/evidence" },
    "mutuallyAuthenticatedTls": { "const": true },
    "outboundNetworkDisabled": { "const": true },
    "businessCredentialsUnavailable": { "const": true },
    "rawCadDeletedOnCompletion": { "const": true },
    "artifactOnlyResponse": { "const": true },
    "sourceHashVerifiedBeforeConversion": { "const": true },
    "converterContractRunnerEnforced": { "const": true },
    "licensingApprovalReference": { "$ref": "#/$defs/evidence" },
    "securityApprovalReference": { "$ref": "#/$defs/evidence" },
    "dataRegionApprovalReference": { "$ref": "#/$defs/evidence" },
    "deletionRetentionApprovalReference": { "$ref": "#/$defs/evidence" },
    "qualificationScore": { "type": "integer", "minimum": 80, "maximum": 100 },
    "qualificationRubricVersion": { "$ref": "#/$defs/evidence" },
    "goldenDatasetSha256": { "$ref": "#/$defs/sha256" },
    "frozenEnvironmentSha256": { "$ref": "#/$defs/sha256" },
    "qualificationEvidenceReference": { "$ref": "#/$defs/evidence" },
    "validFromUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
