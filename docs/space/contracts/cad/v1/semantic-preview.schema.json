{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cp6.local/contracts/space/cad/v1/semantic-preview.schema.json",
  "title": "CP6 Space CAD semantic preview v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "isReadOnlyPreview", "tenantId", "floorLogicalId",
    "floorCode", "sourceSha256", "coordinateTransformSha256", "inventorySha256",
    "profileId", "profileVersion", "profileDefinitionSha256", "mappingPreviewSha256",
    "items", "issues", "summary", "readyForConfirmation", "semanticPreviewSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "isReadOnlyPreview": { "const": true },
    "tenantId": { "type": "string", "format": "uuid" },
    "floorLogicalId": { "type": "string", "format": "uuid" },
    "floorCode": { "$ref": "#/$defs/token" },
    "sourceSha256": { "$ref": "#/$defs/sha256" },
    "coordinateTransformSha256": { "$ref": "#/$defs/sha256" },
    "inventorySha256": { "$ref": "#/$defs/sha256" },
    "profileId": { "type": "string", "format": "uuid" },
    "profileVersion": { "type": "integer", "minimum": 1 },
    "profileDefinitionSha256": { "$ref": "#/$defs/sha256" },
    "mappingPreviewSha256": { "$ref": "#/$defs/sha256" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
    "summary": { "$ref": "#/$defs/summary" },
    "readyForConfirmation": { "type": "boolean" },
    "semanticPreviewSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "token": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceRef": { "type": "string", "minLength": 1, "maxLength": 200 },
    "target": {
      "enum": [
        "Wall", "Column", "Door", "Dock", "Zone", "Aisle", "Rack",
        "Equipment", "VerticalCirculation", "Annotation", "Guide", "RestrictedArea"
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minX", "minY", "maxX", "maxY"],
      "properties": {
        "minX": { "type": "integer" },
        "minY": { "type": "integer" },
        "maxX": { "type": "integer" },
        "maxY": { "type": "integer" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["m11", "m12", "m21", "m22", "offsetX", "offsetY", "offsetZ"],
      "properties": {
        "m11": { "type": "number" },
        "m12": { "type": "number" },
        "m21": { "type": "number" },
        "m22": { "type": "number" },
        "offsetX": { "type": "integer" },
        "offsetY": { "type": "integer" },
        "offsetZ": { "type": "integer" }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "points", "radiusMillimeters", "startAngleDegrees",
        "endAngleDegrees", "isClosed", "transform", "bounds"
      ],
      "properties": {
        "kind": { "enum": ["Point", "Path", "Polygon", "Circle", "Arc", "BlockInstance"] },
        "points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/point" } },
        "radiusMillimeters": { "type": ["integer", "null"], "minimum": 1 },
        "startAngleDegrees": { "type": ["number", "null"] },
        "endAngleDegrees": { "type": ["number", "null"] },
        "isClosed": { "type": "boolean" },
        "transform": { "oneOf": [{ "$ref": "#/$defs/transform" }, { "type": "null" }] },
        "bounds": { "$ref": "#/$defs/bounds" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "rawType", "layerId", "blockName", "attributes"],
      "properties": {
        "sourceRef": { "$ref": "#/$defs/sourceRef" },
        "rawType": { "$ref": "#/$defs/token" },
        "layerId": { "$ref": "#/$defs/token" },
        "blockName": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 512 }
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind", "sourceKey", "decisionSource", "ruleId", "geometryRule",
        "defaultHeightMillimeters", "defaultThicknessMillimeters"
      ],
      "properties": {
        "sourceKind": { "enum": ["Layer", "Block"] },
        "sourceKey": { "$ref": "#/$defs/token" },
        "decisionSource": { "enum": ["ProfileRule", "LayerOverride"] },
        "ruleId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "geometryRule": {
          "enum": ["DirectGeometry", "Centerline", "ClosedBoundary", "BlockFootprint", "InsertionPoint"]
        },
        "defaultHeightMillimeters": { "type": ["integer", "null"], "minimum": 1 },
        "defaultThicknessMillimeters": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previewObjectId", "draftObjectKind", "target", "targetSubtype", "source",
        "appliedMapping", "geometry", "confidence", "disposition", "isConfirmable", "isSelected"
      ],
      "properties": {
        "previewObjectId": { "$ref": "#/$defs/token" },
        "draftObjectKind": { "enum": ["Element", "Zone", "Aisle", "Rack"] },
        "target": { "$ref": "#/$defs/target" },
        "targetSubtype": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "source": { "$ref": "#/$defs/source" },
        "appliedMapping": { "$ref": "#/$defs/mapping" },
        "geometry": { "oneOf": [{ "$ref": "#/$defs/geometry" }, { "type": "null" }] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "disposition": { "enum": ["AutoAccepted", "Candidate", "Rejected"] },
        "isConfirmable": { "type": "boolean" },
        "isSelected": { "type": "boolean" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code", "severity", "sourceRef", "previewObjectId", "sourceKind",
        "sourceKey", "ruleId", "detailToken"
      ],
      "properties": {
        "code": { "$ref": "#/$defs/token" },
        "severity": { "enum": ["Info", "Warning", "Blocking"] },
        "sourceRef": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
        "previewObjectId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "sourceKind": { "enum": ["Layer", "Block", null] },
        "sourceKey": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "ruleId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "detailToken": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceEntityCount", "mappedEntityCount", "autoAcceptedCount", "candidateCount",
        "rejectedCount", "confirmableCount", "selectedCount", "infoCount", "warningCount", "blockingCount"
      ],
      "properties": {
        "sourceEntityCount": { "type": "integer", "minimum": 0 },
        "mappedEntityCount": { "type": "integer", "minimum": 0 },
        "autoAcceptedCount": { "type": "integer", "minimum": 0 },
        "candidateCount": { "type": "integer", "minimum": 0 },
        "rejectedCount": { "type": "integer", "minimum": 0 },
        "confirmableCount": { "type": "integer", "minimum": 0 },
        "selectedCount": { "type": "integer", "minimum": 0 },
        "infoCount": { "type": "integer", "minimum": 0 },
        "warningCount": { "type": "integer", "minimum": 0 },
        "blockingCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
