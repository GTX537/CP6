{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cp6.local/contracts/cad/v1/candidate-worker-release.schema.json",
  "title": "CP6 AutoCAD candidate Worker release Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerKey",
    "releaseVersion",
    "sourceCommit",
    "runtimeIdentifier",
    "autoCadCoreConsoleVersion",
    "autoCadCoreConsoleSha256",
    "managedDxfConverterVersion",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "providerKey": { "const": "cp6-autocad-worker" },
    "releaseVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "runtimeIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "autoCadCoreConsoleVersion": { "$ref": "#/$defs/versionComponent" },
    "autoCadCoreConsoleSha256": { "$ref": "#/$defs/sha256" },
    "managedDxfConverterVersion": { "$ref": "#/$defs/versionComponent" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "length", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"
          },
          "length": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "versionComponent": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.-]{0,63}$"
    }
  }
}
