  "cards": [
    {
      "dot": "cyan",
      "title": "制造业务怎么分工",
      "items": [
        "ERP：客户订单、产品、交付；PUR：请购、采购单、收货。",
        "PLAN：品目策略与 MRP；MES：生产指令、实绩、质量、OEE。",
        "WMS：收发货、库位、库存、扫码；FIN：应收应付、凭证、成本。"
      ]
    },
    {
      "dot": "emerald",
      "title": "共用能力怎么配合",
      "items": [
        "OA 提供申请和待办界面，WF 提供流程状态机与审批回调。",
        "SYS 管理认证与角色权限；PUB 提供附件等公共业务；Platform 提供平台级能力。",
        "连线不代表每个业务自动串联，也不表示模块各自启动一个进程。"
      ]
    },
    {
      "dot": "amber",
      "title": "明确当前能力边界",
      "items": [
        "ERP 订单服务具有 MES/WMS bridge 接口；采购和财务的审批回调在宿主注册。",
        "CRM 对接有启用开关、租户映射和服务身份条件；CRM 应用属于独立项目。",
        "MRP、IoT/WCS 与第三方连接器的现场能力须按实际实现和验收判断。"
      ]
    }
  ]
