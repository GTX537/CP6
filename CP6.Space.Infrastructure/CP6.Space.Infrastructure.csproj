<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition="'$(Cp6MainUseNet10)' == 'true'">net10.0</TargetFramework>
    <NuGetLockFilePath Condition="'$(TargetFramework)' == 'net10.0'">packages.net10.lock.json</NuGetLockFilePath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CP6.Core\CP6.Core.csproj" />
    <ProjectReference Include="..\CP6.Entity\CP6.Entity.csproj" />
    <ProjectReference Include="..\CP6.Space.Application\CP6.Space.Application.csproj" />
    <ProjectReference Include="..\CP6.Space.Domain\CP6.Space.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.30">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.30" />
  </ItemGroup>
</Project>
