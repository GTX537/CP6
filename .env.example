# =====================================================
# CP6 docker-compose 环境变量模板
# =====================================================
# 1. 复制本文件为 .env（.env 已在 .gitignore 中）
# 2. 替换以下占位符为实际值
# 3. 不要将 .env 提交到 git
#
# 生成强密码示例：
#   openssl rand -base64 32   # 32 字节随机
#   openssl rand -hex 16      # 16 字节 hex（适合 JWT）

# SQL Server SA 密码（必须满足复杂度：大小写 + 数字 + 符号，至少 8 位）
MSSQL_SA_PASSWORD=YourStrongPassword_HereChangeMe!

# RabbitMQ
RABBITMQ_USER=cp6
RABBITMQ_PASSWORD=YourMqPassword_HereChangeMe

# JWT Secret（>= 32 字符随机）
JWT_SECRET=YourJwtSecretMinimum32CharactersLong_HereChangeMe

# 可选：自定义端口
# CP6_API_PORT=9991
# CP6_WEB_PORT=8080
