{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Startup": {
    "Mode": "Api",
    "SkipDatabaseInitialization": false,
    "SkipHostedServices": false
  },
  "Release": {
    "Version": "0.0.0-dev",
    "GitSha": "unknown",
    "ApiImageDigest": "unknown",
    "WebImageDigest": "unknown"
  },
  "ConnectionStrings": {
    "_comment": "Override via appsettings.Local.json (gitignored) or env var ConnectionStrings__DefaultConnection",
    "DefaultConnection": "Server=localhost;Database=CP6DB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "Redis": ""
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "cp6",
    "Password": "__SET_VIA_ENV_OR_LOCAL_OVERRIDE__"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "OperLogTopic": "cp6.operlog",
    "ConsumerGroup": "cp6-operlog-consumer"
  },
  "OperLog": {
    "IncludeGet": true,
    "RetentionDays": 7,
    "CleanupIntervalHours": 24
  },
  "Wms": {
    "ScanCleanupIntervalHours": 24
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "App_Data/uploads",
    "S3": {
      "Endpoint": null,
      "Bucket": null,
      "Prefix": "cp6/runtime",
      "AccessKey": null,
      "SecretKey": null,
      "ForcePathStyle": true,
      "ServerSideEncryption": "AES256",
      "KmsKeyId": null
    }
  },
  "JWT": {
    "_comment": "Generate >=32 char random string. Override via JWT__Secret env var.",
    "Secret": "__SET_VIA_ENV_OR_LOCAL_OVERRIDE_MIN_32_CHARS__",
    "Issuer": "CP6",
    "Audience": "CP6.Web"
  },
  "WmsBridge": {
    "Enabled": true
  },
  "Space": {
    "Compatibility": {
      "_comment": "E00 safe default. Configure TenantId+SiteId entries only through the approved space:integration:manage deployment path.",
      "DesignApiEnabled": false,
      "Sites": []
    }
  },
  "SpaceObservability": {
    "AuditQueryEnabled": true,
    "MetricsEnabled": true,
    "_legacyIntegrationEventTimeZoneComment": "Set a Windows or IANA time-zone ID before startup when historical SPACE rows have a null OccurredAtUtc.",
    "LegacyIntegrationEventTimeZoneId": ""
  },
  "OutboundRouting": {
    "_comment": "Gap 4.2 / T14 multi-warehouse routing; false keeps the existing single-warehouse allocator.",
    "Enabled": false
  },
  "OrderCancelBridge": {
    "_comment": "Phase 6 order-cancellation bridge; false replaces it with the no-op implementation.",
    "Enabled": true
  },
  "IntegrationEvent": {
    "_comment": "Phase 6 cross-module event persistence, retry, and dead-letter behavior.",
    "Enabled": true,
    "MaxAttempts": 5,
    "BackoffSeconds": [ 60, 120, 240, 480, 960 ],
    "PollIntervalSeconds": 60
  },
  "Security": {
    "Password": { "MinLength": 8, "RequireUpper": true, "RequireLower": true, "RequireDigit": true, "RequireSymbol": false, "ExpiryDays": 0, "HistoryCount": 3 },
    "Lockout": { "MaxFailedAttempts": 5, "LockoutMinutes": 15, "ResetCounterMinutes": 15 },
    "_comment": "Token.AccessTokenMinutes is the single access-token lifetime setting.",
    "Token": { "AccessTokenMinutes": 15, "RefreshTokenDays": 7 },
    "Cookie": { "Secure": true, "SameSite": "Strict" },
    "Csrf": { "Enabled": true },
    "Sso": { "StateMinutes": 10, "CallbackPath": "/api/auth/sso/callback", "PostLoginRedirect": "/sso/landing", "HttpTimeoutSeconds": 15, "PublicBaseUrl": null, "FrontendBaseUrl": null },
    "TwoFactor": { "Issuer": "CP6", "CodeWindow": 1, "EmailOtpMinutes": 5, "EmailOtpLength": 6, "EmailResendCooldownSeconds": 60, "PendingTokenMinutes": 5, "EmailFallbackEnabled": true },
    "NativeClient": {
      "SsoGrantMinutes": 2,
      "AllowedRedirectUris": [ "cp6-desktop://auth/callback", "cp6-mobile://auth/callback" ],
      "Windows": { "LatestVersion": "1.0.0", "MinimumVersion": "1.0.0", "DownloadUrl": null, "Sha256": null },
      "Android": { "LatestVersion": "1.0.0", "MinimumVersion": "1.0.0", "DownloadUrl": null, "Sha256": null }
    },
    "ImpersonationMinutes": 30
  },
  "Email": {
    "Smtp": { "Host": "", "Port": 587, "User": "", "Pass": "", "From": "no-reply@cp6.local", "EnableSsl": true }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
