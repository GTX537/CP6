{
  "ConnectionStrings": {
    "_comment": "实际密码通过 docker-compose env var ConnectionStrings__DefaultConnection 覆写",
    "DefaultConnection": "Server=cp6-db;Database=CP6DB;User Id=sa;Password=__OVERRIDE_VIA_ENV__;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "Redis": "cp6-redis:6379"
  },
  "RabbitMQ": {
    "HostName": "cp6-mq",
    "Port": 5672,
    "UserName": "cp6",
    "Password": "__OVERRIDE_VIA_ENV__"
  },
  "Kafka": {
    "BootstrapServers": "cp6-kafka:9092",
    "OperLogTopic": "cp6.operlog",
    "ConsumerGroup": "cp6-operlog-consumer"
  },
  "OperLog": {
    "IncludeGet": true,
    "RetentionDays": 7,
    "CleanupIntervalHours": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
