# Environment migration assets are stored through Git LFS, not normal Git objects.
migration/database/*.bak filter=lfs diff=lfs merge=lfs -text
*.dxf -text
*.dwg -text

# Generated Space acceptance packages are byte-stable fixtures. Text
# normalization would invalidate their manifest SHA-256 values on checkout.
CP6.Tests/TestData/Space/Acceptance/** binary

# Release Shadow fixtures contain hashes of sibling files. Preserve exact bytes
# across Windows and hosted Linux checkouts so the offline contract is stable.
tests/fixtures/release-shadow/** -text

# Sanitized Space GA candidate manifests are content-addressed evidence.
docs/space/acceptance/v1.3-ga/authorized-golden-cad-candidates-*.json binary

# Generated AutoCAD evaluation reports retain the evaluator's exact report SHA.
# They are schema-validated separately; text normalization would alter the proof.
docs/space/acceptance/v1.3-ga/autocad-primary-evaluation-*.json binary

# AutoCAD Primary approvals, scorecards, qualification results and incremental
# kickoff manifests are content-addressed GA evidence. Preserve their exact bytes.
docs/space/acceptance/v1.3-ga/autocad-v1-local-boundary-approval-*.json binary
docs/space/acceptance/v1.3-ga/autocad-primary-scorecard-*.json binary
docs/space/acceptance/v1.3-ga/autocad-primary-qualification-*.json binary
docs/space/acceptance/v1.3-ga/autocad-primary-input-*.json binary
docs/space/acceptance/v1.3-ga/formal-golden-business-rules-*.json binary
docs/space/acceptance/v1.3-ga/golden-cad-formal-evidence-*.json binary
docs/space/acceptance/v1.3-ga/three-path-formal-evidence-*.json binary
docs/space/acceptance/v1.3-ga/baseline-governance-formal-evidence-*.json binary
docs/space/acceptance/v1.3-ga/manual-modeling-formal-evidence-*.json binary
docs/space/acceptance/v1.3-ga/cad-start-formal-evidence-*.json binary
docs/space/acceptance/v1.3-ga/viewer-formal-evidence-*.json binary
docs/space/acceptance/v1.3-ga/release-rehearsal-formal-evidence-*.json binary

# Main-sync SQL hashes are deployment evidence and must stay byte-stable.
deploy/production/sql/main-sync-*/**.sql text eol=lf

# P10 verifier recipe is embedded and verified by its exact LF byte hash.
eng/p10/verifier.Dockerfile text eol=lf

# C02 local Schema/example hashes must be identical on Windows and Linux.
contracts/events/platform/**/*.json text eol=lf
contracts/events/erp/**/*.json text eol=lf

# Shared C04A protocol must match the CRM repository byte for byte.
contracts/c04a/TargetRollbackProtocol.cs text eol=lf
contracts/c04a/TargetRollbackSet.cs text eol=lf
contracts/c04a/SourceFrozenProof.cs text eol=lf

# Raw C02 verifier reports retain original bytes and CRLF.
eng/crm/identity-events-fixture/evidence/**/*.json -text whitespace=cr-at-eol
eng/crm/identity-events-fixture/evidence/**/*.xml -text whitespace=cr-at-eol

# Preserve the original local publication verification report bytes.
docs/devops/evidence/local-release-20260910/**/*.json -text whitespace=cr-at-eol
docs/devops/evidence/local-release-20260910/**/*.xml -text whitespace=cr-at-eol

